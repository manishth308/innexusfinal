@@ -0,0 +1,89 @@
+/*
+ * Shared, hand-authored component classes for blocks repeated across
+ * every service/industry page template — currently the "Tools /
+ * Technologies" grid+card and the "Why Choose Us" image panel.
+ *
+ * These exist to replace bracket-syntax arbitrary-value Tailwind
+ * utilities (grid-cols-[40%_60%], max-h-[50px], min-h-[320px]) that were
+ * copy-pasted across 50+ Blade files. Because these rules are written
+ * directly in this source file rather than generated from scanning
+ * Blade templates, Tailwind always includes them in every build — dev
+ * or production — with no dependency on which pages happen to have
+ * been rendered/cached before the build ran.
+ */
+
+@layer components {
+    /*
+     * Visually hides a honeypot input from real visitors while leaving it
+     * present in the DOM for simple bots that auto-fill every field.
+     * Shared by the contact form and the blogger application form.
+     */
+    .hp-field {
+        position: absolute;
+        left: -9999px;
+        top: -9999px;
+        width: 1px;
+        height: 1px;
+        overflow: hidden;
+    }
+
+    .tech-split-grid {
+        display: grid;
+        grid-template-columns: 1fr;
+        gap: 2rem;
+    }
+
+    @media (min-width: 1024px) {
+        .tech-split-grid {
+            grid-template-columns: 40% 60%;
+            column-gap: 4rem;
+        }
+    }
+
+    .tech-card {
+        @apply border border-white/10 bg-white/[0.03] backdrop-blur-sm flex flex-col items-center justify-center gap-2 p-3 rounded-lg transition-all duration-300 overflow-hidden;
+        height: 100px;
+    }
+
+    .tech-card:hover {
+        @apply border-purple-500/40 bg-white/[0.06];
+        box-shadow: 0 0 20px rgba(168, 85, 247, 0.05);
+    }
+
+    /* Centers each logo in a fixed-height frame regardless of its own
+       aspect ratio, so a wide wordmark and a square icon occupy the same
+       footprint in the grid. */
+    .tech-card-icon-frame {
+        @apply flex items-center justify-center w-full px-2;
+        height: 3rem; /* 48px */
+    }
+
+    .tech-card-icon {
+        max-height: 2.5rem; /* 40px */
+        max-width: 100%;
+        object-fit: contain;
+    }
+
+    /* A real <img> in a contain-fit frame, not a CSS background-image on
+       an empty div - if the image ever fails to load (bad URL, blocked
+       request), the browser shows a broken-image icon/alt text here
+       instead of a silent blank rectangle. */
+    .why-choose-image-frame {
+        @apply flex items-center justify-center h-full overflow-hidden;
+        max-height: 20rem; /* 320px */
+    }
+
+    .why-choose-image {
+        max-height: 100%;
+        max-width: 100%;
+        object-fit: contain;
+    }
+
+    /* Caps the whole section's height so it can't stretch tall if the
+       copy column ever grows - pairs with items-center (not
+       items-stretch) on the grid inside it. */
+    .why-choose-section {
+        max-height: 26.25rem; /* 420px */
+        overflow: hidden;
+    }
+}
