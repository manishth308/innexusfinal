+        $this->actingAs($admin)->get("/admin/leads/{$lead->id}/edit")->assertSuccessful();
+    }
+
+    public function test_non_admin_cannot_view_leads(): void
+    {
+        $blogger = User::factory()->create(['role' => UserRole::Blogger]);
